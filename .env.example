# Copy to .env and fill in OPENROUTER_API_KEY. The backend refuses to start
# without it, because the chat cannot work without a model behind it.
OPENROUTER_API_KEY=

# Optional. The backend signs sessions with a per-process secret when this is
# unset, which is correct while the database is rebuilt on every start: a cookie
# that outlived a restart would name a user row that no longer exists.
SESSION_SECRET=

# Optional, defaults to nvidia/nemotron-3.5-lightning:free.
OPENROUTER_MODEL=
